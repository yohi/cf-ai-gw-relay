# Set through Neon Function secrets (not committed). Use random values, not real OAuth.
X_POC_API_KEY=replace-with-random-key-at-least-32-chars
# 32 random bytes, base64-encoded. Example generation: openssl rand -base64 32
X_POC_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# Neon Functions injects DATABASE_URL automatically when attached to Postgres.
# DATABASE_URL=postgresql://...
X_POC_ENABLE_DB_PROBE=false
# Optional bounded SSE test. Max 900; default 20 seconds.
X_POC_MAX_SSE_SECONDS=20
